{
  "name": "classic-calendar",
  "productName": "Classic Calendar",
  "version": "1.0.1",
  "description": "Classic Calendar - Windows 10 Style High-Performance Desktop Calendar",
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:electron": "concurrently -k \"vite\" \"wait-on tcp:5173 && npm run electron:start\"",
    "build:electron": "tsc -p tsconfig.electron.json",
    "electron:start": "npm run build:electron && electron .",
    "build": "tsc -b && vite build && npm run build:electron",
    "dist": "npm run build && electron-builder",
    "dist:dir": "npm run build && electron-builder --dir",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "classic-calendar",
    "windows10",
    "calendar",
    "desktop-app",
    "fluent-ui",
    "react",
    "electron"
  ],
  "author": "nicebyy",
  "license": "MIT",
  "build": {
    "appId": "com.fluentcal.classic",
    "productName": "Classic Calendar",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "assets/**/*",
      "package.json"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "nicebyy",
        "repo": "old-calender"
      }
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Classic Calendar",
      "artifactName": "Classic-Calendar-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Classic-Calendar-Portable-${version}.${ext}"
    }
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "electron-updater": "^6.8.11",
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.9",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/node": "^22.13.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^34.2.0",
    "electron-builder": "^26.18.0",
    "jsdom": "^26.0.0",
    "tailwindcss": "^4.0.9",
    "typescript": "^5.7.3",
    "vite": "^6.1.1",
    "vitest": "^3.0.7",
    "wait-on": "^8.0.2"
  }
}
